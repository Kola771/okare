{
  "name": "okare-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test": "jest",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "npx tsx ./node_modules/typeorm/cli.js",
    "migration:run": "npm run typeorm -- migration:run -d src/datasource.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/datasource.ts",
    "migration:generate": "npm run typeorm -- migration:generate -d src/datasource.ts",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@keyv/redis": "^4.6.0",
    "@nestjs/cache-manager": "^12.0.5",
    "@nestjs/common": "^11.1.3",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.3",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/passport": "^12.0.2",
    "@nestjs/platform-express": "^11.1.3",
    "@nestjs/throttler": "^6.8.0",
    "@nestjs/typeorm": "^11.0.0",
    "argon2": "^0.41.1",
    "cache-manager": "^6.4.3",
    "cacheable": "^2.5.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "keyv": "^5.6.0",
    "mysql2": "^3.12.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.13.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.21"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.3",
    "@nestjs/testing": "^11.1.3",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.0",
    "@types/passport-jwt": "^4.0.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
