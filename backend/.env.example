# ============================================================
# OKARE Backend — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs.
# ============================================================

# --- Base de donnees ---------------------------------------------------
# postgres ou mysql
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=okare

# --- Application -------------------------------------------------------
NODE_ENV=development
PORT=4001
FRONTEND_URL=http://localhost:4000

# --- Super-admin (seed) ------------------------------------------------
SUPER_ADMIN_PHONE="+2290XXXXXXXXX"
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME="Super-admin OKARE"

# --- Demo (seed) -------------------------------------------------------
SEED_DEMO=true
