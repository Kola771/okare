# ============================================================
# OKARE Backend — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs.
# ============================================================

# --- Base de donnees ---------------------------------------------------
# postgres ou mysql
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=okare

# --- Application -------------------------------------------------------
NODE_ENV=development
PORT=4001
FRONTEND_URL=http://localhost:4000

# --- Super-admin (seed) ------------------------------------------------
SUPER_ADMIN_PHONE="+2290XXXXXXXXX"
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME="Super-admin OKARE"

# --- JWT ---------------------------------------------------------------
# JWT — générer le secret avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<valeur générée>
JWT_EXPIRES_IN=90d

# --- Redis -------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# TTL du cache en secondes (par défaut 5 min)
REDIS_TTL=300

# --- Rate limiting -----------------------------------------------------
# Limite globale : 100 requêtes par minute
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
# Limite auth (login, register) : 10 requêtes par minute
THROTTLE_AUTH_TTL=60000
THROTTLE_AUTH_LIMIT=10

# --- Demo (seed) -------------------------------------------------------
SEED_DEMO=true
